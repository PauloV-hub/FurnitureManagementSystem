@model IEnumerable<ArteFormas.Models.Pedido>

@{

    ViewData["Title"] = "Lista de Pedidos";

    var pedidosPendentes = Model.Where(p => p.Status != "Entregue").OrderBy(p => p.DataEntrega).ToList();
    var pedidosEntregues = Model.Where(p => p.Status == "Entregue").OrderByDescending(p => p.DataPedido).ToList();

}

<div class="d-flex justify-content-between mb-10">
    <h1>Pedidos</h1>
    <p>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bg-info bi-plus-circle"></i> Criar Novo Pedido
        </a>
    </p>
</div>
<div class="d-flex justify-content-end mb-3">
    
        <form asp-action="BuscarPorCliente" asp-controller="Pedidoes" method="get">
        <div class="d-flex justify-content-evenly gap-2">
            <input type="text" placeholder="Buscar por Cliente..." name="nomeCliente" class="input-group-text" />
            <button type="submit" class="btn btn-outline-primary p-1">Pesquisar</button>
            <a asp-action="index" class="btn btn-outline-danger p-1" title="Limpar filtro">
                Limpar Filtro
            </a>
        </div>
        </form>
</div>


<!-- Pedidos Pendentes-->

<div class="card mb-4">
    <div class="card-header text-dark">
        <h4 class="mb-0">
            <i class="bi bi-clock-history"></i> Pedidos Pendentes
            <span class="badge bg-dark">@pedidosPendentes.Count</span>
        </h4>
      
    </div>

    <div class="card-body p-0">
        @if(pedidosPendentes.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 25%">Cliente</th>
                            <th style="width: 10%">Data do Pedido</th>
                            <th style="width: 10%">Data de Entrega</th>
                            <th style="width: 10%" class="text-end">Total</th>
                            <th style="width: 10%" class="text-center">Status</th>
                            <th style="width: 30%" class="text-center">Ações</th>
                        </tr>

                    </thead>
                    <tbody>
                        @foreach( var item in pedidosPendentes)
                        {
                            var diasParaEntrega = (item.DataEntrega - DateTime.Today).Days;
                            var classeUrgencia = diasParaEntrega <= 3 ? "table-danger" : (diasParaEntrega <= 7 ? "table-warning" : "");
                            <tr class="@classeUrgencia">
                                <td>
                                    <strong>@item.Cliente.Nome</strong>
                                </td>
                                <td>@item.DataPedido.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @item.DataEntrega.ToString("dd/MM/yyyy")
                                    @if (diasParaEntrega <= 3)
                                    {
                                        <br/><small class="text-danger"></small>
                                    }
                                    else if (diasParaEntrega <= 7)
                                    {
                                        <br/><small class="text-warning"></small>
                                    }
                                </td>
                                <td class="text-end">
                                    <strong>@item.TotalPedido.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-warning text-dark">@item.Status</span>
                                </td>
                                <td class="text-center">
                                        <form asp-action="MarcarComoEntregue" asp-route-id="@item.Id" method="post" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-sm me-1" title="Entregue">
                                                <i class="bi bi-check-circle"></i> Entregue
                                            </button>
                                        </form>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm me-1" title="Ver Detalhes">
                                        Detalhes
                                        </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-1" title="Editar">
                                           Editar
                                        </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm me-1" title="Excluir">
                                           Deletar
                                        </a>
                                   
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }else
        {
             <div class="alert alert-info m-3">
                <i class="bi bi-info-circle"></i> Não há pedidos pendentes no momento.
            </div>
        }
    </div>
</div>

<!-- Pedidos Entregues -->
<div class="card">
    <div class="card-header bg-success text-white">
        <h4 class="mb-0">
            <i class="bi bi-check-circle"></i> Pedidos Entregues 
            <span class="badge bg-light text-dark">@pedidosEntregues.Count</span>
        </h4>
      
    </div>
    <div class="card-body p-0">
        @if (pedidosEntregues.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 25%">Cliente</th>
                            <th style="width: 10%">Data do Pedido</th>
                            <th style="width: 10%">Data de Entrega</th>
                            <th style="width: 10%" class="text-end">Total</th>
                            <th style="width: 10%" class="text-center">Status</th>
                            <th style="width: 30%" class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in pedidosEntregues)
                        {
                            <tr>
                                <td>@item.Cliente.Nome</td>
                                <td>@item.DataPedido.ToString("dd/MM/yyyy")</td>
                                <td>@item.DataEntrega.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">
                                    @item.TotalPedido.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                                </td>
                                <td class="text-center">
                                     <span class="badge bg-success">
                                        <i class="bi bi-check-circle"></i> @item.Status
                                    </span>
                                </td>
                                <td class="text-center">
                                    <form asp-action="MarcarComoPendente" asp-route-id="@item.Id" method="post" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-warning btn-sm me-1" title="Pendente">
                                                <i class="bi bi-check-circle"></i> Pendente
                                            </button>
                                        </form>
                                    <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                                        Detalhes
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                                            Deletar
                                    </a>
                                    
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
          {
            <div class="alert alert-info m-3">
                <i class="bi bi-info-circle"></i> Não há pedidos entregues ainda.
            </div>
        }
    </div>
</div>
